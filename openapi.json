      "ClauseDetail": {
        "description": "One compiled precondition, as the deterministic checker evaluated it.\n\nPresent on both outcomes, because both are claims about the same test: on a\nrecommendation these clauses are the evidence the citation was lawful; on a\nrefusal they are the reason it was not. The reasoning tier never sees this\nshape -- it is produced by ``haven.deterministic.preconditions`` after the\nmodel has already spoken (safety requirement S4).",
        "properties": {
          "actual": {
            "title": "Actual",
            "type": "string"
          },
          "clause": {
            "title": "Clause",
            "type": "string"
          },
          "expected": {
            "title": "Expected",
            "type": "string"
          },
          "explanation": {
            "title": "Explanation",
            "type": "string"
          },
          "satisfied": {
            "title": "Satisfied",
            "type": "boolean"
          }
        },
        "required": [
          "clause",
          "satisfied",
          "expected",
          "actual",
          "explanation"
        ],
        "title": "ClauseDetail",
        "type": "object"
      },
