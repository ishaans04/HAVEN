# HAVEN backend configuration. Copy to .env and edit, or export directly.
# Every value has a working default — the prototype runs with none of these set.

# --- Reasoning tier -------------------------------------------------------
# mock    scripted Granite stand-in. Offline, deterministic. Default, and the
#         terminal link of the provider chain, so a run can never fail open.
# ollama  local Granite via langchain-ollama. Free and unmetered, which is why
#         development and every evaluation sweep run here.
# watsonx IBM watsonx.ai via langchain-ibm. Reserve for integration and the live
#         demo — the Lite tier is token-limited (~300k tokens/month).
#
# ollama and watsonx need the optional extra:  uv sync --extra providers
# The default install has neither, because the offline path must not require them.
HAVEN_LLM_PROVIDER=mock
HAVEN_LLM_MODEL=ibm/granite-3-8b-instruct

WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_API_KEY=
WATSONX_PROJECT_ID=

OLLAMA_URL=http://localhost:11434

# --- Retrieval tier -------------------------------------------------------
# inprocess  TF-IDF stand-in with the ChromaDB interface. No dependencies.
# chroma     real ChromaDB + sentence-transformers (see requirements.txt).
HAVEN_VECTOR_STORE=inprocess
HAVEN_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Shown in the audit bar so an operator can tell a mocked tier from a live one.
HAVEN_BUILD_MODE=prototype

# --- Ledger ---------------------------------------------------------------
# The audit ledger, and the key its entries are signed with. Both are created on
# first use, so an offline run needs neither of these set. Point HAVEN_AUDIT_KEY
# at a real secret store in any deployment where the record has to mean anything.
# HAVEN_LEDGER_DB=haven_ledger.db
# HAVEN_AUDIT_KEY=
# HAVEN_AUDIT_KEY_FILE=.audit_key
