# HAVEN configuration. Copy to .env and edit:
#
#     cp .env.example .env
#
# This file is read at startup by haven/__init__.py, before any setting is
# resolved. A variable already exported in your shell wins over the value here.
# .env is gitignored; .env.example is not, so never put a real key in it.
#
# Every value below has a working default. The prototype runs with none set.

# --- Reasoning tier -------------------------------------------------------
# The provider chain, tried left to right, and this is what actually switches
# the tier on. Leave it unset and the chain is just ("mock",) -- watsonx is
# never attempted, no error is raised, and Zone 6 quietly reports served_by:
# mock. That is by design: falling back is safer than failing to start, but it
# does mean a missing chain looks exactly like working credentials.
#
#   mock     scripted Granite stand-in. Offline, deterministic, and always the
#            terminal link, so a run can never fail open.
#   ollama   local Granite via langchain-ollama. Free and unmetered, which is
#            why development and every evaluation sweep run here.
#   watsonx  IBM watsonx.ai via langchain-ibm. Reserve for integration and the
#            live demo -- the Lite tier is token-limited (~300k tokens/month).
#
# ollama and watsonx need the optional extra:  uv sync --extra providers
# The base install has neither, because the offline path must not require them.
#
# HAVEN_LLM_CHAIN=watsonx,mock
HAVEN_LLM_CHAIN=

# Superseded by HAVEN_LLM_CHAIN when that is set. Kept because a single-provider
# configuration should keep working.
HAVEN_LLM_PROVIDER=mock

# --- watsonx.ai credentials -----------------------------------------------
# From your IBM Cloud account and watsonx project. Check them without spending a
# sweep's worth of tokens:
#
#     uv run python -m scripts.check_providers
#
# WATSONX_URL must match the region the project lives in -- a key that is valid
# in us-south returns 401 against eu-de, which reads as a bad key and is not.
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_API_KEY=
WATSONX_PROJECT_ID=

# The Granite model to call. watsonx model ids change between releases, so paste
# the one your project actually lists rather than trusting this default. For
# Ollama this is the local tag instead, e.g. granite3.3:8b.
HAVEN_LLM_MODEL=ibm/granite-3-8b-instruct

OLLAMA_URL=http://localhost:11434

# --- Retrieval tier -------------------------------------------------------
# lexical  BM25 alone. The offline terminal: no download, no service.
# hybrid   adds dense retrieval (Chroma + fastembed), which fetches its model on
#          first use and therefore cannot be part of the offline guarantee.
#          Needs the extra:  uv sync --extra rag
HAVEN_RETRIEVAL_MODE=lexical
HAVEN_DENSE_MODEL=BAAI/bge-small-en-v1.5
# HAVEN_CHROMA_DIR=

# --- Corpus ---------------------------------------------------------------
# Points at an artefact from `python -m compiler.cli emit`. Unset means the
# hand-authored corpus in haven/rag/corpus.py.
# HAVEN_CORPUS=corpus/compiled/corpus-2026.08.json

# Shown in the audit bar so an operator can tell a mocked tier from a live one.
HAVEN_BUILD_MODE=prototype

# --- Ledger ---------------------------------------------------------------
# The audit ledger and the key its entries are signed with. Both are created on
# first use, so an offline run needs neither set. Point HAVEN_AUDIT_KEY at a real
# secret store in any deployment where the record has to mean anything.
# HAVEN_LEDGER_DB=haven_ledger.db
# HAVEN_AUDIT_KEY=
# HAVEN_AUDIT_KEY_FILE=.audit_key
