# HAVEN backend configuration. Copy to .env and edit, or export directly.
# Every value has a working default — the prototype runs with none of these set.

# --- Reasoning tier -------------------------------------------------------
# mock    scripted Granite stand-in. Offline, deterministic. Default.
# ollama  local Granite. Free unlimited iteration during development.
# watsonx IBM watsonx.ai. Reserve for integration and the live demo — the Lite
#         tier is token-limited (~300k tokens/month).
HAVEN_LLM_PROVIDER=mock
HAVEN_LLM_MODEL=ibm/granite-3-8b-instruct

WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_API_KEY=
WATSONX_PROJECT_ID=

OLLAMA_URL=http://localhost:11434

# --- Retrieval tier -------------------------------------------------------
# inprocess  TF-IDF stand-in with the ChromaDB interface. No dependencies.
# chroma     real ChromaDB + sentence-transformers (see requirements.txt).
HAVEN_VECTOR_STORE=inprocess
HAVEN_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Shown in the audit bar so an operator can tell a mocked tier from a live one.
HAVEN_BUILD_MODE=prototype
